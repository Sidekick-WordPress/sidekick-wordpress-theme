{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "customTemplates": [
        {
            "name": "single-product",
            "title": "Single Product",
            "postTypes": [
                "product"
            ]
        }
    ],
    "settings": {
        "appearanceTools": true,
        "layout": {
            "contentSize": "1350px",
            "wideSize": "1920px"
        },
        "color": {
            "palette": [
                {
                    "slug": "base",
                    "color": "#ffffff",
                    "name": "Base"
                },
                {
                    "slug": "contrast",
                    "color": "#000000",
                    "name": "Contrast"
                },
                {
                    "slug": "primary",
                    "color": "#cc2936",
                    "name": "Baker.dev red"
                },
                {
                    "slug": "secondary",
                    "color": "#fff8e2",
                    "name": "Baker.dev light gold"
                },
                {
                    "slug": "error",
                    "color": "#cb2b2b",
                    "name": "Error"
                },
                {
                    "slug": "warning",
                    "color": "#dea81e",
                    "name": "Warning"
                },
                {
                    "slug": "okay",
                    "color": "#628b48",
                    "name": "Okay"
                },
                {
                    "slug": "darkest-grey",
                    "color": "#050505",
                    "name": "Darkest Grey"
                },
                {
                    "slug": "darker-grey",
                    "color": "#202020",
                    "name": "Darker Grey"
                },
                {
                    "slug": "dark-grey",
                    "color": "#404040",
                    "name": "Dark Grey"
                },
                {
                    "slug": "mid-grey",
                    "color": "#808080",
                    "name": "Mid Grey"
                },
                {
                    "slug": "light-grey",
                    "color": "#bfbfbf",
                    "name": "Light Grey"
                },
                {
                    "slug": "lighter-grey",
                    "color": "#e6e6e6",
                    "name": "Lighter Grey"
                },
                {
                    "slug": "lightest-grey",
                    "color": "#f0f0f0",
                    "name": "Lightest Grey"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "fontWeight": true,
            "fontStyle": true,
            "fontSizes": [
                {
                    "slug": "small",
                    "name": "Small",
                    "size": "1.25rem",
                    "fluid": {
                        "min": "1rem",
                        "max": "1.25rem"
                    }
                },
                {
                    "slug": "medium",
                    "name": "Medium",
                    "size": "1.75rem",
                    "fluid": {
                        "min": "1.25rem",
                        "max": "1.75rem"
                    }
                },
                {
                    "slug": "large",
                    "name": "Large",
                    "size": "2.5rem",
                    "fluid": {
                        "min": "1.75rem",
                        "max": "2.5rem"
                    }
                },
                {
                    "slug": "x-large",
                    "name": "Extra Large",
                    "size": "3.5rem",
                    "fluid": {
                        "min": "2.5rem",
                        "max": "3.5rem"
                    }
                }
            ]
        },
        "blocks": {
            "core/button": {
                "border": {
                    "color": true,
                    "radius": true,
                    "style": true,
                    "width": true
                },
                "shadow": {
                    "presets": [
                        {
                            "slug": "button-lift",
                            "name": "Button Lift",
                            "shadow": "0 2px 6px rgba(0, 0, 0, 0.15)"
                        }
                    ]
                }
            }
        }
    },
    "styles": {
        "spacing": {
            "blockGap": "1.5rem"
        },
        "color": {
            "background": "var(--wp--preset--color--base)",
            "text": "var(--wp--preset--color--contrast)"
        },
        "typography": {
            "fontFamily": "system-ui, sans-serif",
            "fontSize": "100%",
            "lineHeight": "1.6"
        },
        "elements": {
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--darkest-grey)",
                    "text": "var(--wp--preset--color--base)"
                },
                "border": {
                    "radius": "4px",
                    "width": "2px",
                    "style": "solid",
                    "color": "var(--wp--preset--color--darkest-grey)"
                },
                "spacing": {
                    "padding": {
                        "top": "0.75rem",
                        "right": "1.5rem",
                        "bottom": "0.75rem",
                        "left": "1.5rem"
                    }
                },
                "typography": {
                    "fontWeight": "600",
                    "textTransform": "uppercase",
                    "letterSpacing": "0.03em"
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--lighter-grey)",
                        "text": "var(--wp--preset--color--contrast)"
                    },
                    "border": {
                        "color": "var(--wp--preset--color--lighter-grey)"
                    }
                },
                ":focus": {
                    "color": {
                        "background": "var(--wp--preset--color--darkest-grey)",
                        "text": "var(--wp--preset--color--base)"
                    },
                    "outline": {
                        "color": "var(--wp--preset--color--primary)",
                        "style": "solid",
                        "width": "2px",
                        "offset": "2px"
                    }
                },
                ":active": {
                    "color": {
                        "background": "var(--wp--preset--color--darkest-grey)",
                        "text": "var(--wp--preset--color--base)"
                    }
                }
            }
        },
        "blocks": {
            "core/navigation": {
                "typography": {
                    "fontWeight": "600",
                    "textTransform": "uppercase"
                }
            }
        }
    }
}
